# Youngtimer Garage — variables d'environnement
# Ne jamais committer .env.local avec de vraies valeurs.

# Supabase — publiques, sûres côté client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — serveur uniquement, NE JAMAIS préfixer par NEXT_PUBLIC_
# Non requis pour la Phase 0 (aucune opération admin/service-role encore nécessaire).
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel, futures phases — ne pas ajouter avant d'en avoir besoin
NEXT_PUBLIC_MAP_PROVIDER=
MAP_PROVIDER_SECRET=
EMAIL_PROVIDER_API_KEY=
ANALYTICS_WRITE_KEY=
